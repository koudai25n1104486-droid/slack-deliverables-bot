# 秘密情報はGitHubに登録しないでください。
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me

# 収集元：本文の「#制作物」を判定します。
SLACK_SOURCE_CHANNEL_ID=C_REPLACE_SOURCE
# 架空データで試す投稿先。本番とは分けてください。
SLACK_TEST_CHANNEL_ID=C_REPLACE_TEST
# 学校が指定した週次まとめの投稿先。
SLACK_OUTPUT_CHANNEL_ID=C_REPLACE_OUTPUT

# 初期状態は読み取りのみ。手動投稿を許可するときにtrueへ変更。
ALLOW_SLACK_POST=false
# 常駐時の週次投稿を有効にするときだけtrueへ変更。
ENABLE_WEEKLY=false
# メンションによる随時集計・曜日時刻変更を使う場合に有効化します。
ENABLE_MENTION_COMMANDS=false
# 投稿済みの親メッセージをピン留めします。
AUTO_PIN=true

# 制作物が多すぎる場合は不完全な一覧を投稿せず停止します。
MAX_ITEMS=50
MAX_PAGES=20

# 投稿＋Canvas追記はboth、投稿だけはthread、Canvasだけはcanvas。
OUTPUT_MODE=both
# 本番CanvasとテストCanvasはそれぞれ明示的に設定します。
SLACK_CANVAS_ID=
SLACK_TEST_CANVAS_ID=
